rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Isolamento estrito: cada usuário autenticado só pode ler e escrever em sua própria subárvore
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Bloqueio padrão de qualquer acesso em coleções não mapeadas
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

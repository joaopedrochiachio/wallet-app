# Configuração do Firebase Client SDK (público no navegador)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Segredo de proteção para chamadas de rotinas Cron/API e consultas administrativas no servidor
# Deve ser uma string randômica forte configurada no provedor de hospedagem
CRON_SECRET=your-secure-cron-secret-token

# ==============================================================================
# Configuração da API da OpenAI (Lida exclusivamente no servidor - NUNCA use NEXT_PUBLIC_)
# ==============================================================================
# Chave da API da OpenAI (Responses API). Configure em variáveis de ambiente seguras do servidor.
OPENAI_API_KEY=your-openai-api-key-here

# Modelo Principal (Padrão: gpt-6-luna).
# Para testar o modelo opcional de alta capacidade gpt-6-sol, descomente a linha abaixo:
# OPENAI_MODEL_OVERRIDE=gpt-6-sol

# Ativação opcional de etapa adicional de IA para o Auditor Contábil (Padrão: false - auditor local determinístico)
# ENABLE_AI_AUDITOR=false

# ==============================================================================
# Limites de Uso e Proteção de Orçamento (Piloto: alvo de até R$ 30 / mês)
# ==============================================================================
# Cotas por usuário autenticado:
# - Chat: 15 mensagens/dia | 150 mensagens/mês
# - Diagnóstico: 2 análises/dia | 10 análises/mês
# - Padrões adicionais: 4 buscas/dia | 20 buscas/mês
# - Teto estimado individual: US$ 0,75 por usuário/mês
#
# Limite global interno do aplicativo (compartilhado entre todos os usuários): US$ 4,50 / mês
# Hard spend limit recomendado a ser configurado na plataforma OpenAI: US$ 5,00 / mês
